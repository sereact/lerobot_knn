# Python and tooling
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Poster build intermediates (`make pdf` regenerates them)
poster/*.aux
poster/*.fls
poster/*.fdb_latexmk
poster/*.log
poster/*.out

# Packaging
build/
dist/

# Local environment
.env
.envrc

# Experiment outputs (feature caches, checkpoints, venvs, the LIBERO-plus clone, rollouts, videos, logs, results)
# stay local. Only the configurations are tracked, in place, so the paths the README, docs and scripts use resolve.
/outputs/*
!/outputs/knn/
!/outputs/vla/
!/outputs/libero_plus/
/outputs/*/*
# kNN policy configurations (Optuna trials, the official v2_39, ablations, sweeps) and Optuna seed lists
!/outputs/knn/best_v1*.json
!/outputs/knn/trial1*.json
!/outputs/knn/v2_*.json
!/outputs/knn/enqueue_*.json
!/outputs/knn/smoke_enqueue.json
!/outputs/knn/ablations/
!/outputs/knn/ksweep/
!/outputs/knn/retry/
!/outputs/knn/tta/
# kNN-with-VLA-embedder configurations, embedder keys, held-out split, SmolVLA training config, openpi norm stats
!/outputs/vla/configs/
!/outputs/vla/split.json
!/outputs/vla/extra_keys.json
!/outputs/vla/smolvla_libero_train_config.json
!/outputs/vla/openpi_assets/
# LIBERO-plus environment setup (libero_config/ is generated by setup.sh with absolute paths)
!/outputs/libero_plus/setup.sh
!/outputs/libero_plus/venv_constraints.txt
