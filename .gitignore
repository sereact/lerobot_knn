# Python and tooling
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Poster build intermediates (`make pdf` regenerates them)
poster/*.aux
poster/*.fls
poster/*.fdb_latexmk
poster/*.log
poster/*.out

# Paper build intermediates (`make -C paper` regenerates them) and the downloaded CoRL template (its .sty and .bst are
# copied into paper/)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.log
paper/*.out
paper/template/
paper/corl_template.zip

# Packaging
build/
dist/

# Local environment
.env
.envrc

# Experiment outputs (feature caches, checkpoints, venvs, the LIBERO-plus clone, rollouts, videos, logs, results)
# stay local, as do the one-off run scripts (phase_*.sh). Only configurations are tracked, in place, so the paths the README, docs and scripts use resolve.
/outputs/*
!/outputs/*/
/outputs/*/*
# The tri-arm study's helper scripts
!/outputs/*/scripts/
# kNN policy configurations (Optuna trials, the official v2_39, ablations, sweeps) and Optuna seed lists
!/outputs/knn/best_v1*.json
!/outputs/knn/trial1*.json
!/outputs/knn/v2_*.json
!/outputs/knn/enqueue_*.json
!/outputs/knn/smoke_enqueue.json
!/outputs/knn/ablations/
!/outputs/knn/ksweep/
!/outputs/knn/retry/
!/outputs/knn/tta/
# kNN-with-VLA-embedder configurations, embedder keys, held-out split
!/outputs/vla/configs/
!/outputs/vla/split.json
!/outputs/vla/extra_keys.json
# LIBERO-plus environment setup (libero_config/ is generated by setup.sh with absolute paths) and the fixed
# sample of 420 variants every policy ran on
!/outputs/libero_plus/setup.sh
!/outputs/libero_plus/sample.json
!/outputs/libero_plus/venv_constraints.txt
