      "isDeleted": false,
      "boundElements": null,
      "updated": 1790944117981,
      "link": null,
      "locked": false,
      "text": "91.7% on Libero and \n82.4% on Libero-Plus with kNN\nNo training. Smallest drop among all tested policies.*\n<Somewhere at the bottom with a star we say that Libero-Plus \nis somewhat lucky becnhmark for kNN, because correct actions \nare the same as in Libero>.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "91.7% on Libero and \n82.4% on Libero-Plus with kNN\nNo training. Smallest drop among all tested policies.*\n<Somewhere at the bottom with a star we say that Libero-Plus \nis somewhat lucky becnhmark for kNN, because correct actions \nare the same as in Libero>.",
      "autoResize": true,
      "lineHeight": 1.35
    },
